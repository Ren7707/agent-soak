{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ren7707.github.io/agent-soak/platform.manifest.schema.json",
  "title": "agent-soak platform manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter", "platform", "capabilities", "scenarios"],
  "properties": {
    "schema_version": { "const": 1 },
    "adapter": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|[/\\])\\.\\.(?:[/\\]|$)).+$" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "base_url_env", "write_gate_env", "test_data_prefix"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "name": { "type": "string" },
        "base_url_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "health_path": { "type": "string" },
        "write_gate_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "test_data_prefix": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" },
        "require_cleanup": { "type": "boolean" },
        "production": { "type": "boolean" }
      }
    },
    "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mode"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "title": { "type": "string" },
          "mode": { "enum": ["readonly", "write"] },
          "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "timeout_ms": { "type": "integer", "minimum": 1 },
          "retries": { "type": "integer", "minimum": 0, "maximum": 10 },
          "cleanup": { "type": "string" }
        }
      }
    }
  }
}
