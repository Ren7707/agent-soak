{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ren7707.github.io/agent-soak/contract.schema.json",
  "title": "agent-soak semantic contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "field": { "type": "string", "minLength": 1 },
    "semantic_type": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "policy": { "$ref": "#/$defs/policy" },
    "risk_profile": { "type": "string", "minLength": 1 },
    "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } },
    "invariants": { "type": "array", "items": { "$ref": "#/$defs/invariant" } },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "expected": { "type": "object" },
    "status": { "type": "string" },
    "review_required": { "type": "boolean" },
    "approved": { "type": "boolean" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_values": { "enum": ["known_only", "known_or_explicit_custom", "observed_or_explicit_custom"] },
        "normalize_case": { "type": "boolean" },
        "trim_whitespace": { "type": "boolean" },
        "generate_risk_cases": { "type": "boolean" },
        "reject_unclassified_value": { "type": "boolean" },
        "unique": { "type": "boolean" },
        "idempotent": { "type": "boolean" },
        "risk_expected": { "type": "object", "additionalProperties": false, "properties": { "accepted": { "type": "boolean" }, "resourceCreated": { "type": "boolean" } } }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "semantic_type": { "type": "string", "minLength": 1 },
        "examples": { "type": "array" },
        "negative_examples": { "type": "array" },
        "required": { "type": "boolean" },
        "policy": { "$ref": "#/$defs/policy" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["valid", "boundary", "nearby_semantic", "wrong_type", "missing", "normalization", "duplicate", "relationship", "lifecycle"] },
        "input": { "type": "object" },
        "expected": { "type": "object" },
        "description": { "type": "string" },
        "sequence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "type": { "enum": ["equals", "not_equals", "in", "before", "state_transition"] },
        "left": { "type": "string", "minLength": 1 },
        "right": { "type": "string", "minLength": 1 },
        "values": { "type": "array" },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "transitions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": { "from": { "type": "string" }, "to": { "type": "string" } } } },
        "severity": { "enum": ["low", "medium", "high"] },
        "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
    ,"lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "transitions"],
      "properties": {
        "states": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } },
        "invalid_transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "expected": { "type": "object" },
        "description": { "type": "string" }
      }
    }
  }
}
